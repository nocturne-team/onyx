# Copy to .env. These are baked into the binary at build time by
# crates/onyx-core/build.rs; real environment variables win over this file.
# Everything is optional: a feature whose value is empty is just disabled.

# Modrinth OAuth app (modrinth.com/settings/applications). Redirect URIs:
# http://127.0.0.1:47823/callback, with :47824 and :47825 as fallbacks.
ONYX_MODRINTH_CLIENT_ID=
ONYX_MODRINTH_CLIENT_SECRET=

# Azure / Entra app ID used for Microsoft and Minecraft login.
# Release builds need an ID approved for the Minecraft API (aka.ms/mce-reviewappid)
# and refuse to compile with Prism Launcher's ID.
ONYX_MSA_CLIENT_ID=

# Discord application (discord.com/developers/applications), for rich presence and invites.
ONYX_DISCORD_APP_ID=
ONYX_DISCORD_PUBLIC_KEY=
ONYX_DISCORD_CLIENT_SECRET=
